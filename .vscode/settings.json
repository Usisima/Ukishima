{
  "editor.wordWrap": "on",

  "liveServer.settings.host": "127.0.0.1",
  "liveServer.settings.file": "/index.html",

  // ── Archivos de notas: no son documentos LaTeX, no compilar ──
  "files.associations": {
    "**/texto/*.tex": "plaintext"
  },

  // ── LaTeX Workshop ──────────────────────────────────────────
  // No compilar automáticamente al guardar (los .tex son plantillas)
  "latex-workshop.latex.autoBuild.run": "never",
  // No mostrar mensajes de error/advertencia de compilación LaTeX
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  // Vista previa de fórmulas al hacer hover sobre $...$
  "latex-workshop.hover.preview.enabled": true,
  "latex-workshop.hover.preview.scale": 1.2,
  // Resaltado de sintaxis mejorado
  "latex-workshop.formatting.latex": "latexindent",
  // Desactivar chktex (clave actual en versiones recientes de LaTeX Workshop)
  "latex-workshop.linting.chktex.enabled": false,
  "latex-workshop.chktex.enabled": false,
  // Limpiar con glob en vez de latexmk (latexmk requiere Perl)
  "latex-workshop.latex.clean.method": "glob",
  // LuaLaTeX — necesario para fontspec y luacode (también disponible pdflatex)
  "latex-workshop.latex.recipe.default": "lualatex",
  "latex-workshop.latex.recipes": [
    { "name": "lualatex", "tools": ["lualatex"] },
    { "name": "pdflatex", "tools": ["pdflatex"] }
  ],
  // Guardar archivos auxiliares en subcarpeta .build/ (mantiene el directorio limpio)
  "latex-workshop.latex.outDir": "%DIR%/.build",
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    }
  ]
}

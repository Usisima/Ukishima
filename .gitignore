# ── Libros PDF y secciones temporales (locales, grandes — no subir) ──
pdfs/*.pdf
pdfs/*/

# ── Notas transcritas (contenido de libros, no subir) ────────
# texto/* ignora todas las subcarpetas y archivos dentro de texto/
texto/*
# Solo se permite el paquete de estilos (no es contenido de libro)
!texto/ukishima-notas.sty

# -- Instaladores / herramientas locales (no son assets web) --------
tools/
*.exe

# -- Notas de funcionalidades (local, no es asset web) --
FUNCIONALIDADES.md

# -- Salida del navegador MCP (Playwright) --
.playwright-mcp/

# -- Scripts/artefactos temporales de desarrollo --
_*.js
_*.html
_*.txt

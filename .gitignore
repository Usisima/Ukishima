!texto/ukishima-notas.sty

# ── Scripts de transcripción (herramientas locales) ──────────
ocr.py
extraer-bloques.py
crear-estructura.py
nougat_colab.ipynb

# -- Instaladores / herramientas locales (no son assets web) --------
tools/
*.exe

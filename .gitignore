# ── PDFs originales ──────────────────────────────────────────
pdfs/entrada/*.pdf

# ── Salida de OCR (texto extraído, archivos procesados) ──────
pdfs/salida/*.txt
pdfs/salida/*.mmd
pdfs/salida/*.pdf

# ── Notas transcritas (contenido de libros, no subir) ────────
